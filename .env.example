# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored — do NOT commit real secrets.

# --- Application ----------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_NAME=Daystar-Customer-Portal

# --- PostgreSQL Database --------------------------------------------
# Local Postgres — change USER/PASS to match your local install.
DB_NAME=customer_portal
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# --- AMMP API -------------------------------------------------------
# Fleet-wide master key — the ONLY credential the app uses to talk to
# the data provider. Users are scoped in-app by their customer_id.
AMMP_MASTER_KEY=
# Legacy fallback used only for local dev where no master key is set.
AMMP_API_KEY=

# --- Security -------------------------------------------------------
# Base64-encoded 32-byte key used for AES-256-GCM TOTP secret encryption.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional — protects the /api/internal/audit endpoint.
INTERNAL_LOG_SECRET=

# Optional — set to 1 to log AMMP cache hits/misses to the server console.
# Handy when validating that the memory cache is actually taking effect.
CACHE_DEBUG=

# --- Bootstrap admin (npm run seed) ---------------------------------
# Creates the first admin so someone can log in and create every other
# account on a fresh database. Skipped if either EMAIL or PASSWORD is
# empty. Safe to re-run: skips when the email already exists.
# Rotate the password out of the env after the first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional overrides — sensible defaults are used when unset.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_SURNAME=
BOOTSTRAP_ADMIN_TIMEZONE=

# --- Email (SendGrid) -----------------------------------------------
SENDGRID_API_KEY=
FROM_EMAIL=noreply@daystar-power.com

# --- AWS S3 (customer logos, planned data uploads, reports) --------
BUCKET_NAME=
BUCKET_REGION=eu-west-1
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
